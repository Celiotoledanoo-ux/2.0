-- 1. LIMPIEZA Y TIPOS
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

DO $$ BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_type WHERE typname = 'user_role') THEN
        CREATE TYPE user_role AS ENUM ('ADMIN', 'CASHIER', 'MANAGER', 'OWNER');
    END IF;
END $$;

-- 2. TABLAS DE NÚCLEO
CREATE TABLE IF NOT EXISTS users (
    id UUID PRIMARY KEY, -- Se sincroniza con Auth
    email TEXT UNIQUE NOT NULL,
    name TEXT NOT NULL,
    role user_role DEFAULT 'CASHIER',
    active BOOLEAN DEFAULT true,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE IF NOT EXISTS categories (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT UNIQUE NOT NULL,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE IF NOT EXISTS inventory (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name TEXT NOT NULL,
    sku TEXT UNIQUE NOT NULL,
    category_id UUID REFERENCES categories(id),
    price DECIMAL(12, 2) NOT NULL CHECK (price >= 0),
    stock INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0),
    min_stock INTEGER DEFAULT 5,
    active BOOLEAN DEFAULT true,
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE IF NOT EXISTS sales (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    total DECIMAL(12, 2) NOT NULL DEFAULT 0,
    payment_method TEXT NOT NULL,
    status TEXT DEFAULT 'COMPLETED',
    created_by UUID REFERENCES users(id),
    created_at TIMESTAMPTZ DEFAULT now()
);

CREATE TABLE IF NOT EXISTS sales_items (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    sale_id UUID REFERENCES sales(id) ON DELETE CASCADE,
    product_id UUID REFERENCES inventory(id),
    quantity INTEGER NOT NULL CHECK (quantity > 0),
    price_at_sale DECIMAL(12, 2) NOT NULL
);

CREATE TABLE IF NOT EXISTS inventory_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    product_id UUID REFERENCES inventory(id),
    user_id UUID REFERENCES users(id),
    change_amount INTEGER NOT NULL,
    reason TEXT,
    created_at TIMESTAMPTZ DEFAULT now()
);

-- 3. TRIGGERS (EL MOTOR AUTOMÁTICO)
CREATE OR REPLACE FUNCTION handle_sale_stock()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE inventory SET stock = stock - NEW.quantity WHERE id = NEW.product_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS tr_update_stock_on_sale ON sales_items;
CREATE TRIGGER tr_update_stock_on_sale
AFTER INSERT ON sales_items
FOR EACH ROW EXECUTE FUNCTION handle_sale_stock();

-- 4. FUNCIÓN RPC PARA AJUSTES MANUALES (Usada por tu repositorio)
CREATE OR REPLACE FUNCTION increment_stock(row_id UUID, x INT)
RETURNS SETOF inventory AS $$
BEGIN
  RETURN QUERY
  UPDATE inventory
  SET stock = stock + x
  WHERE id = row_id
  RETURNING *;
END;
$$ LANGUAGE plpgsql;
